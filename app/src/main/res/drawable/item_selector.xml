<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state - Oceanic Blue with Border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2200B0FF" />
            <stroke android:width="2dp" android:color="#00B0FF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Selected state -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#4400B0FF" />
            <stroke android:width="1dp" android:color="#00B0FF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0091EA" />
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
